            "minimum": 1,
            "maximum": 600
          },
          "next_due": {
            "type": "string",
            "format": "date"
          },
          "pauses_used": {
            "type": "integer",
            "minimum": 0,
            "maximum": 2
          }
        }
      },
      "Facility": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "scope",
          "name",
          "limit",
