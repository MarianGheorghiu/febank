          {
            "$ref": "#/components/schemas/RevenueDraft"
          },
          {
            "$ref": "#/components/schemas/FactoringDraft"
          },
          {
            "$ref": "#/components/schemas/PauseDraft"
          },
          {
            "$ref": "#/components/schemas/RefinanceDraft"
          }
        ],
        "discriminator": {
          "propertyName": "kind",
          "mapping": {
            "term": "#/components/schemas/TermDraft",
            "lombard": "#/components/schemas/LombardDraft",
            "revenue": "#/components/schemas/RevenueDraft",
            "factoring": "#/components/schemas/FactoringDraft",
            "pause": "#/components/schemas/PauseDraft",
            "refinance": "#/components/schemas/RefinanceDraft"
          }
        }
      },
      "Estimate": {
        "type": "object",
