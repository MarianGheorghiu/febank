{
  "openapi": "3.1.0",
  "info": {
    "title": "MBank customer credit API",
    "version": "1.0.0",
    "description": "Customer-scoped credit workspace. Use one SQL transaction for wallet posting, principal, application state, audit and idempotency. The backend revalidates every estimate and permission."
  },
  "security": [
    {
      "session": []
    }
  ],
  "paths": {
    "/v1/me/credit": {
      "get": {
        "operationId": "getCustomerCredit",
        "responses": {
          "200": {
            "description": "Committed credit snapshot; same authenticated wallet revision",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Snapshot"
                }
              }
            }
          },
          "401": {
            "description": "Authentication required",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "Scope membership or permission denied",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "Service unavailable; never fall back to demo money",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/v1/me/credit/commands": {
      "post": {
        "operationId": "executeCreditCommand",
        "parameters": [
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^[a-zA-Z0-9_-]{8,120}$"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Command"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Committed credit snapshot; same authenticated wallet revision",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Snapshot"
                }
              }
            }
          },
          "401": {
            "description": "Authentication required",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "Scope membership or permission denied",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "Service unavailable; never fall back to demo money",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "400": {
            "description": "Malformed request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "409": {
            "description": "Version conflict or idempotency key reused with different payload",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "422": {
            "description": "Business validation failed, nothing posted",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "session": {
        "type": "apiKey",
        "in": "cookie",
        "name": "session",
        "description": "Example cookie name. Configure the bank authenticated session middleware, CSRF and authorized origins."
      }
    },
    "schemas": {
      "Money": {
        "type": "string",
        "pattern": "^\\d{1,12}\\.\\d{2}$",
        "description": "Exact nonnegative decimal, two minor-unit digits. Do not decode as float64."
      },
      "Scope": {
        "type": "string",
        "pattern": "^(personal|business:[A-Za-z0-9_-]+)$",
        "description": "Borrower scope. Resolve membership and permissions from the authenticated session."
      },
      "Policy": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "lombard_base_rate_bps",
          "lombard_min_months",
          "lombard_max_months",
          "revenue_min_amount",
          "revenue_min_share_bps",
          "revenue_max_share_bps",
          "revenue_factor_threshold_bps",
          "revenue_low_factor_bps",
          "revenue_high_factor_bps"
        ],
        "properties": {
          "lombard_base_rate_bps": {
            "type": "integer",
            "minimum": 0,
            "maximum": 10000
          },
          "lombard_min_months": {
            "type": "integer",
            "minimum": 1,
            "maximum": 600
          },
          "lombard_max_months": {
            "type": "integer",
            "minimum": 1,
            "maximum": 600
          },
          "revenue_min_amount": {
            "type": "string",
            "pattern": "^\\d{1,12}\\.\\d{2}$",
            "description": "Exact nonnegative decimal, two minor-unit digits. Do not decode as float64."
          },
          "revenue_min_share_bps": {
            "type": "integer",
            "minimum": 0,
            "maximum": 10000
          },
          "revenue_max_share_bps": {
            "type": "integer",
            "minimum": 0,
            "maximum": 10000
          },
          "revenue_factor_threshold_bps": {
            "type": "integer",
            "minimum": 0,
            "maximum": 10000
          },
          "revenue_low_factor_bps": {
            "type": "integer",
            "minimum": 10000,
            "maximum": 20000
          },
          "revenue_high_factor_bps": {
            "type": "integer",
            "minimum": 10000,
            "maximum": 20000
          }
        }
      },
      "Business": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "name",
          "verified",
          "cash"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000
          },
          "verified": {
            "type": "boolean"
          },
          "cash": {
            "type": "string",
            "pattern": "^\\d{1,12}\\.\\d{2}$",
            "description": "Exact nonnegative decimal, two minor-unit digits. Do not decode as float64."
          }
        }
      },
      "Product": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "segment",
          "name",
          "min_amount",
          "max_amount",
