          "min_months": {
            "type": "integer",
            "minimum": 1,
            "maximum": 600
          },
          "max_months": {
            "type": "integer",
            "minimum": 1,
            "maximum": 600
          },
          "annual_rate_bps": {
            "type": "integer",
            "minimum": 0,
            "maximum": 10000
          }
        }
