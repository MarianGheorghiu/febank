          },
          "status": {
            "type": "string",
            "enum": [
              "connected",
              "syncing",
              "offline"
            ]
          }
        }
      },
      "Invoice": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "scope",
          "reference",
          "debtor",
          "currency",
          "amount",
          "advance_bps",
          "fee_bps",
          "due",
          "status"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          },
          "scope": {
            "type": "string",
            "pattern": "^(personal|business:[A-Za-z0-9_-]+)$",
