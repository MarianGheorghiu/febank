{
  "openapi": "3.1.0",
  "info": {
    "title": "MBank Currencies \u2014 proposed Go service contract",
    "version": "1.0.0"
  },
  "security": [
    {
      "session": []
    }
  ],
  "paths": {
    "/v1/me/currencies": {
      "get": {
        "operationId": "getCurrencies",
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Snapshot"
                }
              }
            }
          },
          "400": {
            "description": "Invalid request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "Authentication required",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "Operation forbidden",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "409": {
            "description": "Stale quote or idempotency conflict",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "422": {
            "description": "Insufficient funds, invalid precision or execution restrictions",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "Service unavailable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/v1/me/currencies/quotes": {
      "post": {
        "operationId": "quoteExchange",
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Quote"
                }
              }
            }
          },
          "400": {
            "description": "Invalid request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "Authentication required",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "Operation forbidden",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "409": {
            "description": "Stale quote or idempotency conflict",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "422": {
            "description": "Insufficient funds, invalid precision or execution restrictions",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "Service unavailable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Draft"
              }
            }
          }
        }
      }
    },
    "/v1/me/currencies/exchanges": {
      "post": {
        "operationId": "confirmExchange",
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Snapshot"
                }
              }
            }
          },
          "400": {
            "description": "Invalid request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "Authentication required",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "Operation forbidden",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "409": {
            "description": "Stale quote or idempotency conflict",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "422": {
            "description": "Insufficient funds, invalid precision or execution restrictions",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "Service unavailable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Confirmation"
              }
            }
          }
        },
        "parameters": [
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 8,
              "maxLength": 100
            }
          }
        ]
      }
    }
  },
  "components": {
    "securitySchemes": {
      "session": {
        "type": "apiKey",
        "in": "cookie",
        "name": "session"
      }
    },
    "schemas": {
      "Decimal": {
        "type": "string",
        "pattern": "^\\d+(\\.\\d{1,18})?$",
        "example": "108.00"
      },
      "Timestamp": {
        "type": "string",
        "format": "date-time",
        "pattern": "Z$"
      },
      "Account": {
        "type": "object",
        "required": [
          "id",
          "kind",
          "asset",
          "name",
          "available",
          "reserved",
          "usd_price",
          "decimals"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "type": "string",
            "enum": [
              "fiat",
              "crypto",
              "stock"
            ]
          },
          "asset": {
            "type": "string",
            "minLength": 1
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "available": {
            "$ref": "#/components/schemas/Decimal"
          },
          "reserved": {
            "$ref": "#/components/schemas/Decimal"
          },
          "usd_price": {
            "$ref": "#/components/schemas/Decimal"
          },
          "decimals": {
            "type": "integer",
            "minimum": 0,
            "maximum": 18
          }
        }
      },
      "Asset": {
        "type": "object",
        "required": [
          "symbol",
          "name",
          "kind",
          "status",
          "decimals"
        ],
        "properties": {
          "symbol": {
            "type": "string",
            "minLength": 1
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "type": "string",
            "enum": [
              "fiat",
              "crypto",
              "stock"
            ]
          },
          "status": {
            "type": "string",
            "enum": [
              "ACTIVE",
              "SELL_ONLY",
              "HALTED"
            ]
          },
          "decimals": {
            "type": "integer",
            "minimum": 0,
            "maximum": 18
          }
        }
      },
      "HistoryPoint": {
        "type": "object",
        "required": [
          "id",
          "at",
          "fiat",
          "crypto",
          "stock"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "at": {
            "oneOf": [
              {
                "$ref": "#/components/schemas/Timestamp"
              },
              {
                "type": "null"
              }
            ]
          },
          "fiat": {
            "$ref": "#/components/schemas/Decimal"
          },
          "crypto": {
            "$ref": "#/components/schemas/Decimal"
          },
          "stock": {
            "$ref": "#/components/schemas/Decimal"
          }
        }
      },
      "Snapshot": {
        "type": "object",
        "required": [
          "schema_version",
          "mode",
          "as_of",
          "accounts",
          "assets",
          "history"
        ],
        "properties": {
          "schema_version": {
            "type": "integer",
            "const": 1
          },
          "mode": {
            "type": "string",
            "enum": [
              "demo",
              "live"
            ]
          },
          "as_of": {
            "$ref": "#/components/schemas/Timestamp"
          },
          "accounts": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Account"
            }
          },
          "assets": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Asset"
            }
          },
          "history": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/HistoryPoint"
            }
          }
        }
      },
      "Draft": {
        "type": "object",
        "required": [
          "source",
          "target",
          "amount"
        ],
        "properties": {
          "source": {
            "type": "string",
            "minLength": 1
          },
          "target": {
            "type": "string",
            "minLength": 1
          },
          "amount": {
            "$ref": "#/components/schemas/Decimal"
          }
        }
      },
      "Quote": {
        "type": "object",
        "required": [
          "id",
          "source",
          "target",
          "requested",
          "debited",
          "received",
          "fee_usd",
          "remainder_usd",
          "expires_at"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "source": {
            "type": "string",
            "minLength": 1
          },
          "target": {
            "type": "string",
            "minLength": 1
          },
          "requested": {
            "$ref": "#/components/schemas/Decimal"
          },
          "debited": {
            "$ref": "#/components/schemas/Decimal"
          },
          "received": {
            "$ref": "#/components/schemas/Decimal"
          },
          "fee_usd": {
            "$ref": "#/components/schemas/Decimal"
          },
          "remainder_usd": {
            "$ref": "#/components/schemas/Decimal"
          },
          "expires_at": {
            "description": "Quote expiration, 5 minutes (300 seconds) after creation.",
            "$ref": "#/components/schemas/Timestamp"
          }
        }
      },
      "Confirmation": {
        "type": "object",
        "required": [
          "quote_id"
        ],
        "properties": {
          "quote_id": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "Error": {
        "type": "object",
        "required": [
          "error"
        ],
        "properties": {
          "error": {
            "type": "object",
            "required": [
              "code",
              "message"
            ],
            "properties": {
              "code": {
                "type": "string",
                "minLength": 1
              },
              "message": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      }
    }
  }
}
