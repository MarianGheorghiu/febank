  "components": {
    "securitySchemes": {
      "sessionCookie": {
        "type": "apiKey",
        "in": "cookie",
        "name": "session"
      }
    },
    "schemas": {
      "StockCandle": {
        "type": "object",
        "required": [
          "label",
          "open",
          "high",
          "low",
          "close"
        ],
        "properties": {
          "label": {
            "type": "string"
          },
          "open": {
            "type": "string",
            "pattern": "^\\d+(\\.\\d{1,18})?$",
            "example": "123.45000000"
          },
          "high": {
            "type": "string",
            "pattern": "^\\d+(\\.\\d{1,18})?$",
            "example": "123.45000000"
          },
          "low": {
            "type": "string",
            "pattern": "^\\d+(\\.\\d{1,18})?$",
            "example": "123.45000000"
          },
          "close": {
            "type": "string",
            "pattern": "^\\d+(\\.\\d{1,18})?$",
            "example": "123.45000000"
          }
        }
      },
      "StockCharts": {
        "type": "object",
        "required": [
          "1D",
          "1W",
          "1M",
          "1Y",
          "ALL"
        ],
        "properties": {
          "1D": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/StockCandle"
            }
          },
          "1W": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/StockCandle"
            }
          },
          "1M": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/StockCandle"
            }
          },
          "1Y": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/StockCandle"
            }
          },
          "ALL": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/StockCandle"
            }
          }
        }
      },
      "StockInstrument": {
        "type": "object",
        "required": [
          "symbol",
          "name",
          "exchange",
          "price_usd",
          "change_24h",
          "change_7d",
          "volume",
          "market_cap",
          "category",
          "sector",
          "region",
          "fractional",
          "can_buy",
          "can_sell",
          "buy_restriction",
          "sell_restriction",
          "min_order_usd",
          "max_order_usd",
          "fee_bps",
          "spread_bps",
          "stats",
          "news",
          "charts"
        ],
        "properties": {
          "symbol": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "exchange": {
            "type": "string"
          },
          "price_usd": {
            "type": "string",
            "pattern": "^\\d+(\\.\\d{1,18})?$",
            "example": "123.45000000"
          },
          "change_24h": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^-?\\d+(\\.\\d{1,18})?$"
              },
              {
                "type": "null"
              }
            ]
          },
          "change_7d": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^-?\\d+(\\.\\d{1,18})?$"
              },
              {
                "type": "null"
              }
            ]
          },
          "volume": {
            "type": "string"
          },
          "market_cap": {
            "type": "string"
          },
          "category": {
            "type": "string"
          },
          "sector": {
            "type": "string"
          },
          "region": {
            "type": "string"
          },
          "fractional": {
            "type": "boolean"
          },
          "can_buy": {
            "type": "boolean"
          },
          "can_sell": {
            "type": "boolean"
          },
          "buy_restriction": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "sell_restriction": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "min_order_usd": {
            "type": "string",
            "pattern": "^\\d+(\\.\\d{1,18})?$",
            "example": "123.45000000"
          },
          "max_order_usd": {
            "type": "string",
            "pattern": "^\\d+(\\.\\d{1,18})?$",
            "example": "123.45000000"
          },
          "fee_bps": {
            "type": "integer",
            "minimum": 0,
            "maximum": 500
          },
          "spread_bps": {
            "type": "integer",
            "minimum": 0,
            "maximum": 500
          },
          "stats": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "label",
                "value",
                "unit",
                "icon"
              ],
              "properties": {
                "label": {
                  "type": "string"
                },
                "value": {
                  "type": "string"
                },
                "unit": {
                  "type": "string"
                },
                "icon": {
                  "type": "string",
                  "enum": [
                    "Globe",
                    "Activity",
                    "DollarSign",
                    "PieChart",
                    "Flame",
                    "ShieldCheck"
                  ]
                },
                "highlight": {
                  "type": "boolean"
                }
              }
            }
          },
          "news": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "id",
                "source",
                "time",
                "title",
                "sentiment"
              ],
              "properties": {
                "id": {
                  "type": "integer"
                },
                "source": {
                  "type": "string"
                },
                "time": {
                  "type": "string"
                },
                "title": {
                  "type": "string"
                },
                "sentiment": {
                  "type": "string"
                }
              }
            }
          },
          "charts": {
            "$ref": "#/components/schemas/StockCharts"
          }
        }
      },
      "StockPosition": {
        "type": "object",
        "required": [
          "symbol",
          "name",
          "sector",
          "quantity",
          "reserved",
          "average_cost_usd",
          "price_usd",
          "value_usd",
          "cost_usd",
          "unrealized_usd",
          "unrealized_percent"
        ],
        "properties": {
          "symbol": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "sector": {
            "type": "string"
          },
          "quantity": {
            "type": "string",
            "pattern": "^\\d+(\\.\\d{1,18})?$",
            "example": "123.45000000"
          },
          "reserved": {
            "type": "string",
            "pattern": "^\\d+(\\.\\d{1,18})?$",
            "example": "123.45000000"
          },
          "average_cost_usd": {
            "type": "string",
            "pattern": "^\\d+(\\.\\d{1,18})?$",
            "example": "123.45000000"
          },
          "price_usd": {
            "type": "string",
            "pattern": "^\\d+(\\.\\d{1,18})?$",
            "example": "123.45000000"
          },
          "value_usd": {
            "type": "string",
            "pattern": "^\\d+(\\.\\d{1,18})?$",
            "example": "123.45000000"
          },
          "cost_usd": {
            "type": "string",
            "pattern": "^\\d+(\\.\\d{1,18})?$",
            "example": "123.45000000"
          },
          "unrealized_usd": {
            "type": "string",
            "pattern": "^-?\\d+(\\.\\d{1,18})?$"
          },
          "unrealized_percent": {
            "type": "string",
            "pattern": "^-?\\d+(\\.\\d{1,18})?$"
          }
        }
      },
      "StockOrder": {
        "type": "object",
        "required": [
          "id",
          "created_at",
          "symbol",
          "side",
          "type",
          "status",
          "quantity",
          "price_usd",
          "target_price_usd",
          "fee_usd",
          "total_usd",
          "currency",
          "reserved_cash",
          "note"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          },
          "symbol": {
            "type": "string"
          },
          "side": {
            "type": "string",
            "enum": [
              "BUY",
              "SELL"
            ]
          },
          "type": {
            "type": "string",
            "enum": [
              "MARKET",
              "LIMIT",
              "STOP"
            ]
          },
          "status": {
            "type": "string",
            "enum": [
              "PENDING",
              "FILLED",
              "CANCELLED",
              "REJECTED"
            ]
          },
          "quantity": {
            "type": "string",
            "pattern": "^\\d+(\\.\\d{1,18})?$",
            "example": "123.45000000"
          },
          "price_usd": {
            "type": "string",
            "pattern": "^\\d+(\\.\\d{1,18})?$",
            "example": "123.45000000"
          },
          "target_price_usd": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^\\d+(\\.\\d{1,18})?$",
                "example": "123.45000000"
              },
              {
                "type": "null"
              }
            ]
          },
          "fee_usd": {
            "type": "string",
