{
  "openapi": "3.1.0",
  "info": {
    "title": "MBank Stocks & Trading",
    "version": "1.0.0",
    "description": "Decimal strings and authenticated customer scope. All money/quantity/reservation changes must commit atomically into the common wallet ledger; five-minute quotes; idempotent order, cancellation and plan mutations. Plan execution and dividend crediting are server-owned jobs."
  },
  "security": [
    {
      "sessionCookie": []
    }
  ],
  "paths": {
    "/v1/me/stocks": {
      "get": {
        "operationId": "getStocksSnapshot",
        "summary": "getStocksSnapshot",
        "responses": {
          "200": {
            "description": "Authoritative result",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/StocksSnapshot"
                }
              }
            }
          },
          "400": {
            "description": "Invalid input",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "Authentication required",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "Permission or risk restriction",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "409": {
            "description": "Version, quote or idempotency conflict",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "422": {
            "description": "Insufficient balance or liquidity",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
