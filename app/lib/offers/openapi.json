          },
          "active": {
            "type": "boolean"
          },
          "source": {
            "type": "string",
            "enum": [
              "subscription"
            ]
          },
          "subscription_id": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1,
                "maxLength": 120
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "plan",
          "active",
          "source",
          "subscription_id"
        ]
      },
