{
  "openapi": "3.1.0",
  "info": {
    "title": "MBank Audit Evidence API",
    "version": "1.0.0",
    "description": "Complete-snapshot UI prototype. Snapshot revision covers the annotation journal. Actor and permissions come from server session. No client event insertion/update/deletion endpoint. Business services must publish immutable audit evidence through a transactional outbox. Monetary values in payload JSON must remain exact decimal strings."
  },
  "security": [
    {
      "session": []
    }
  ],
  "paths": {
    "/v1/admin/audit": {
      "get": {
        "operationId": "getAuditSnapshot",
        "description": "Return a complete consistent evidence window; never mark a truncated page as complete. For production volume, evolve this contract to server cursors plus aggregate/facet endpoints before enabling large datasets.",
        "responses": {
          "200": {
            "description": "Snapshot",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Snapshot"
                }
              }
            }
          },
          "400": {
            "description": "Invalid request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "Authentication required",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "Insufficient audit permissions",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "409": {
            "description": "Revision mismatch, unavailable evidence or idempotency conflict",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "Audit service unavailable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/v1/admin/audit/access": {
      "post": {
        "operationId": "recordAuditAccess",
        "parameters": [
          {
            "in": "header",
            "name": "Idempotency-Key",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 1
            },
            "description": "Bind authenticated operator and canonical command; replay committed result once."
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AccessRequest"
              }
            }
          }
        },
        "responses": {
          "204": {
            "description": "Access recorded"
          },
          "400": {
            "description": "Invalid request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "Authentication required",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "Insufficient audit permissions",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "409": {
            "description": "Revision mismatch, unavailable evidence or idempotency conflict",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "Audit service unavailable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/v1/admin/audit/notes": {
      "post": {
        "operationId": "appendAuditNote",
        "parameters": [
          {
            "in": "header",
            "name": "Idempotency-Key",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 1
            },
            "description": "Bind authenticated operator and canonical command; replay committed result once."
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/NoteRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "AuditNote",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuditNote"
                }
              }
            }
          },
          "400": {
            "description": "Invalid request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "Authentication required",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "Insufficient audit permissions",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "409": {
            "description": "Revision mismatch, unavailable evidence or idempotency conflict",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "Audit service unavailable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/v1/admin/audit/exports": {
      "post": {
        "operationId": "recordEvidenceExport",
        "parameters": [
          {
            "in": "header",
            "name": "Idempotency-Key",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 1
            },
            "description": "Bind authenticated operator and canonical command; replay committed result once."
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ExportRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "ExportReceipt",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ExportReceipt"
                }
              }
            }
          },
          "400": {
            "description": "Invalid request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "Authentication required",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "Insufficient audit permissions",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "409": {
            "description": "Revision mismatch, unavailable evidence or idempotency conflict",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "Audit service unavailable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "session": {
        "type": "apiKey",
        "in": "cookie",
        "name": "mbank_session"
      }
    },
    "schemas": {
      "AuditEvent": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "timestamp": {
            "type": "string",
            "format": "date-time"
          },
          "source": {
            "enum": [
              "IDENTITY",
              "USERS",
              "TRANSACTIONS",
              "RATES",
              "CARDS",
              "MARKETS",
              "RISK",
              "SYSTEM",
              "AUDIT",
              "SUBSCRIPTIONS",
              "REFERRALS",
              "ANALYTICS"
            ]
          },
          "domain": {
            "enum": [
              "PLATFORM",
              "FIAT",
              "CRYPTO",
              "STOCK"
            ]
          },
          "category": {
            "enum": [
              "ACCESS",
              "SECURITY",
              "FINANCIAL",
              "CONFIGURATION",
              "COMPLIANCE",
              "SYSTEM",
              "DATA_ACCESS"
            ]
          },
          "action": {
            "type": "string"
          },
          "severity": {
            "enum": [
              "INFO",
              "WARNING",
              "CRITICAL"
            ]
          },
          "outcome": {
            "enum": [
              "SUCCESS",
              "DENIED",
              "FAILED"
            ]
          },
          "actor": {
            "type": "string"
          },
          "actorRole": {
            "enum": [
              "ADMIN",
              "CLIENT",
              "SYSTEM",
              "UNKNOWN"
            ]
          },
          "target": {
            "type": "string"
          },
          "reason": {
            "type": "string"
          },
          "correlationId": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "requestId": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "sessionId": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "ip": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "durationMs": {
            "anyOf": [
              {
                "type": "number",
                "minimum": 0
              },
              {
                "type": "null"
              }
            ]
          },
          "before": {},
          "after": {},
          "origin": {
            "const": "SERVER"
          },
          "evidenceKind": {
            "enum": [
              "HISTORY",
              "SNAPSHOT"
            ]
          }
        },
        "required": [
          "id",
          "timestamp",
          "source",
          "domain",
          "category",
          "action",
          "severity",
          "outcome",
          "actor",
          "actorRole",
          "target",
          "reason",
          "correlationId",
          "requestId",
          "sessionId",
          "ip",
          "durationMs",
          "before",
          "after",
          "origin"
        ]
      },
      "AuditNote": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string"
          },
          "eventId": {
            "type": "string"
          },
          "actor": {
            "type": "string"
          },
          "timestamp": {
            "type": "string",
            "format": "date-time"
          },
          "text": {
            "type": "string",
            "minLength": 10,
            "maxLength": 500
          }
        },
        "required": [
          "id",
          "eventId",
          "actor",
          "timestamp",
          "text"
        ]
      },
      "SourceHealth": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "source": {
            "enum": [
              "IDENTITY",
              "USERS",
              "TRANSACTIONS",
              "RATES",
              "CARDS",
              "MARKETS",
              "RISK",
              "SYSTEM",
              "AUDIT",
              "SUBSCRIPTIONS",
              "REFERRALS",
              "ANALYTICS"
            ]
          },
          "status": {
            "enum": [
              "CONNECTED",
              "ERROR"
            ]
          },
          "localCount": {
            "type": "integer",
            "const": 0
          },
          "message": {
            "type": "string"
          },
          "totalCount": {
            "type": "integer",
            "minimum": 0
          },
          "latestAt": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "source",
          "status",
          "localCount",
          "message"
        ]
      },
      "Snapshot": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "schema_version": {
            "const": 1
          },
          "mode": {
            "const": "live"
          },
          "as_of": {
            "type": "string",
            "format": "date-time"
          },
          "complete": {
            "const": true
          },
          "revision": {
            "type": "integer",
            "minimum": 0
          },
          "events": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/AuditEvent"
            }
          },
          "notes": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/AuditNote"
            }
          },
          "health": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/SourceHealth"
            },
            "minItems": 11,
            "maxItems": 11
          },
          "warnings": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "schema_version",
          "mode",
          "as_of",
          "complete",
          "revision",
          "events",
          "notes",
          "health",
          "warnings"
        ]
      },
      "Filters": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "query": {
            "type": "string"
          },
          "source": {
            "type": "string"
          },
          "severity": {
            "type": "string"
          },
          "outcome": {
            "type": "string"
          },
          "domain": {
            "type": "string"
          },
          "actor": {
            "type": "string"
          },
          "category": {
            "type": "string"
          },
          "origin": {
            "type": "string"
          },
          "from": {
            "type": "string"
          },
          "to": {
            "type": "string"
          },
          "correlationId": {
            "type": "string"
          }
        },
        "required": [
          "query",
          "source",
          "severity",
          "outcome",
          "domain",
          "actor",
          "category",
          "origin",
          "from",
          "to",
          "correlationId"
        ]
      },
      "AccessRequest": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "schema_version": {
            "const": 1
          }
        },
        "required": [
          "schema_version"
        ]
      },
      "NoteRequest": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "schema_version": {
            "const": 1
          },
          "event_id": {
            "type": "string"
          },
          "text": {
            "type": "string",
            "minLength": 10,
            "maxLength": 500
          },
          "expected_revision": {
            "type": "integer",
            "minimum": 0
          }
        },
        "required": [
          "schema_version",
          "event_id",
          "text",
          "expected_revision"
        ]
      },
      "ExportRequest": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "schema_version": {
            "const": 1
          },
          "format": {
            "enum": [
              "CSV",
              "JSON"
            ]
          },
          "reason": {
            "type": "string",
            "minLength": 10,
            "maxLength": 500
          },
          "generated_at": {
            "type": "string",
            "format": "date-time"
          },
          "name": {
            "type": "string",
            "pattern": "^mbank-audit-[\\w.-]+\\.(csv|json)$"
          },
          "event_ids": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "minItems": 1,
            "uniqueItems": true
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "filters": {
            "$ref": "#/components/schemas/Filters"
          },
          "sort": {
            "enum": [
              "NEWEST",
              "OLDEST",
              "SEVERITY"
            ]
          },
          "display_time_zone": {
            "enum": [
              "UTC",
              "Europe/Bucharest"
            ]
          }
        },
        "required": [
          "schema_version",
          "format",
          "reason",
          "generated_at",
          "name",
          "event_ids",
          "sha256",
          "filters",
          "sort",
          "display_time_zone"
        ]
      },
      "ExportReceipt": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string"
          },
          "timestamp": {
            "type": "string",
            "format": "date-time"
          },
          "event_ids": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "minItems": 1,
            "uniqueItems": true
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        },
        "required": [
          "id",
          "timestamp",
          "event_ids",
          "sha256"
        ]
      },
      "Error": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "error": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "code": {
                "type": "string"
              },
              "message": {
                "type": "string"
              }
            },
            "required": [
              "code",
              "message"
            ]
          }
        },
        "required": [
          "error"
        ]
      }
    }
  }
}
