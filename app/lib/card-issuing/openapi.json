{
  "openapi": "3.1.0",
  "info": {
    "title": "MBank Card Issuing Admin API",
    "version": "1.0.0",
    "description": "Shared customer-card servicing. All wire amounts are exact decimal strings. No PAN, CVV or PIN are allowed. Actor is derived from the authenticated administrator session."
  },
  "security": [
    {
      "sessionCookie": []
    }
  ],
  "paths": {
    "/v1/admin/cards": {
      "get": {
        "operationId": "getIssuingSnapshot",
        "responses": {
          "200": {
            "description": "Authoritative masked issuing registry",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/IssuingSnapshot"
                }
              }
            }
          },
          "401": {
            "description": "Session required",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "Administrator required",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "409": {
            "description": "Card, registry or idempotency conflict",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "422": {
            "description": "Invalid command or eligibility",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "Issuer processor unavailable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/v1/admin/cards/commands": {
      "post": {
        "operationId": "executeIssuingCommand",
        "parameters": [
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 8,
              "maxLength": 100
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/IssuingCommand"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Authoritative masked issuing registry",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/IssuingSnapshot"
                }
              }
            }
          },
          "401": {
            "description": "Session required",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "Administrator required",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "409": {
            "description": "Card, registry or idempotency conflict",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "422": {
            "description": "Invalid command or eligibility",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "Issuer processor unavailable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "sessionCookie": {
        "type": "apiKey",
        "in": "cookie",
        "name": "session"
      }
    },
    "schemas": {
      "Limits": {
        "type": "object",
        "required": [
          "daily",
          "monthly",
          "atmDaily"
        ],
        "properties": {
          "daily": {
            "type": "string",
            "pattern": "^\\d+\\.\\d{2}$",
            "description": "Exact non-negative decimal in card currency, maximum 1000000000.00; Go stores integer minor units."
          },
          "monthly": {
            "type": "string",
            "pattern": "^\\d+\\.\\d{2}$",
            "description": "Exact non-negative decimal in card currency, maximum 1000000000.00; Go stores integer minor units."
          },
          "atmDaily": {
            "type": "string",
            "pattern": "^\\d+\\.\\d{2}$",
            "description": "Exact non-negative decimal in card currency, maximum 1000000000.00; Go stores integer minor units."
          }
        }
      },
      "Channels": {
        "type": "object",
        "required": [
          "online",
          "atm",
          "contactless",
          "international"
        ],
        "properties": {
          "online": {
            "type": "boolean"
          },
          "atm": {
            "type": "boolean"
          },
          "contactless": {
            "type": "boolean"
          },
          "international": {
            "type": "boolean"
          }
        }
      },
      "Card": {
        "type": "object",
        "required": [
          "id",
          "userId",
          "type",
          "network",
          "currency",
          "last4",
          "expiry",
          "status",
          "limits",
          "channels",
          "spentToday",
          "spentThisMonth",
          "delivery",
          "deliveryAddress",
          "trackingReference",
          "createdAt",
          "updatedAt",
          "version",
          "replacesCardId",
          "replacedByCardId"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "userId": {
            "type": "string"
          },
          "type": {
            "type": "string",
            "enum": [
              "PHYSICAL",
              "VIRTUAL"
            ]
          },
          "network": {
            "type": "string",
            "enum": [
              "VISA",
              "MASTERCARD"
            ]
          },
          "currency": {
            "type": "string",
            "enum": [
              "EUR",
              "USD",
              "RON"
            ]
          },
          "last4": {
            "type": "string",
            "pattern": "^\\d{4}$"
          },
          "expiry": {
            "type": "string",
            "pattern": "^(0[1-9]|1[0-2])/\\d{2}$"
          },
          "status": {
            "type": "string",
            "enum": [
              "PENDING",
              "ACTIVE",
              "FROZEN",
              "BLOCKED",
              "TERMINATED"
            ]
          },
          "limits": {
            "$ref": "#/components/schemas/Limits"
          },
          "channels": {
            "$ref": "#/components/schemas/Channels"
          },
          "spentToday": {
            "type": "string",
            "pattern": "^\\d+\\.\\d{2}$",
            "description": "Exact non-negative decimal in card currency, maximum 1000000000.00; Go stores integer minor units."
          },
          "spentThisMonth": {
            "type": "string",
            "pattern": "^\\d+\\.\\d{2}$",
            "description": "Exact non-negative decimal in card currency, maximum 1000000000.00; Go stores integer minor units."
          },
          "delivery": {
            "type": "string",
            "enum": [
              "NOT_REQUIRED",
              "ORDERED",
              "DISPATCHED",
              "DELIVERED"
            ]
          },
          "deliveryAddress": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "trackingReference": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time"
          },
          "version": {
            "type": "integer",
            "minimum": 1
          },
          "replacesCardId": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "replacedByCardId": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "customerDeletedAt": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ],
            "description": "Customer deletion tombstone. Deleted cards must be excluded from all customer snapshots and reveal endpoints; retain operational records for admin audit."
          }
        }
      },
      "Customer": {
        "type": "object",
        "required": [
          "id",
          "name",
          "email",
          "accountStatus",
          "kycStatus",
          "deliveryAddress"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "email": {
            "type": "string",
            "format": "email"
          },
          "accountStatus": {
            "type": "string",
            "enum": [
              "ACTIVE",
              "BLOCKED"
            ]
          },
          "kycStatus": {
            "type": "string",
            "enum": [
              "VERIFIED",
              "IN_REVIEW"
            ]
          },
          "deliveryAddress": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          }
        }
      },
      "Audit": {
        "type": "object",
        "required": [
          "id",
          "timestamp",
          "actor",
          "action",
          "cardId",
          "userId",
          "reason",
          "before",
          "after"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "timestamp": {
            "type": "string",
            "format": "date-time"
          },
          "actor": {
            "type": "string"
          },
          "action": {
            "type": "string",
            "enum": [
              "ISSUE",
              "EXPORT",
              "ACTIVATE",
              "FREEZE",
              "UNFREEZE",
              "BLOCK",
              "TERMINATE",
              "REPLACE",
              "DISPATCH",
              "DELIVER",
              "UPDATE_CONTROLS"
            ]
          },
          "cardId": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "userId": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "reason": {
            "type": "string"
          },
          "before": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/Card"
              },
              {
                "type": "null"
              }
            ]
          },
          "after": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/Card"
              },
              {
                "type": "null"
              }
            ]
          },
          "exportedCardIds": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "uniqueItems": true
          }
        }
      },
      "Error": {
        "type": "object",
        "required": [
          "error"
        ],
        "properties": {
          "error": {
            "type": "object",
            "required": [
              "code",
              "message"
            ],
            "properties": {
              "code": {
                "type": "string"
              },
              "message": {
                "type": "string"
              }
            }
          }
        }
      },
      "Policy": {
        "type": "object",
        "properties": {
          "maxOpenCardsPerCustomer": {
            "type": "integer",
            "minimum": 1
          },
          "maxMonthlyLimit": {
            "type": "string",
            "pattern": "^\\d+\\.\\d{2}$",
            "description": "Exact non-negative decimal in card currency, maximum 1000000000.00; Go stores integer minor units."
          },
          "defaultLimits": {
            "$ref": "#/components/schemas/Limits"
          },
          "currencies": {
            "type": "array",
            "items": {
              "enum": [
                "EUR",
                "USD",
                "RON"
              ]
            }
          },
          "networks": {
            "type": "array",
            "items": {
              "enum": [
                "VISA",
                "MASTERCARD"
              ]
            }
          }
        },
        "required": [
          "maxOpenCardsPerCustomer",
          "maxMonthlyLimit",
          "defaultLimits",
          "currencies",
          "networks"
        ]
      },
      "IssuingSnapshot": {
        "type": "object",
        "properties": {
          "schema_version": {
            "const": 1
          },
          "mode": {
            "enum": [
              "demo",
              "live"
            ]
          },
          "revision": {
            "type": "integer",
            "minimum": 0,
            "format": "int64"
          },
          "as_of": {
            "type": "string",
            "format": "date-time"
          },
          "policy": {
            "$ref": "#/components/schemas/Policy"
          },
          "customers": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Customer"
            }
          },
          "cards": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Card"
            }
          },
          "audit": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Audit"
            }
          }
        },
        "required": [
          "schema_version",
          "mode",
          "revision",
          "as_of",
          "policy",
          "customers",
          "cards",
          "audit"
        ]
      },
      "IssueCommand": {
        "type": "object",
        "properties": {
          "expected_revision": {
            "type": "integer",
            "minimum": 0,
            "format": "int64"
          },
          "reason": {
            "type": "string",
            "minLength": 10,
            "maxLength": 500
          },
          "action": {
            "const": "ISSUE"
          },
          "userId": {
            "type": "string"
          },
          "type": {
            "enum": [
              "PHYSICAL",
              "VIRTUAL"
            ]
          },
          "network": {
            "enum": [
              "VISA",
              "MASTERCARD"
            ]
          },
          "currency": {
            "enum": [
              "EUR",
              "USD",
              "RON"
            ]
          },
          "limits": {
            "$ref": "#/components/schemas/Limits"
          }
        },
        "required": [
          "expected_revision",
          "reason",
          "action",
          "userId",
          "type",
          "network",
          "currency",
          "limits"
        ]
      },
      "ActionCommand": {
        "type": "object",
        "properties": {
          "expected_revision": {
            "type": "integer",
            "minimum": 0,
            "format": "int64"
          },
          "reason": {
            "type": "string",
            "minLength": 10,
            "maxLength": 500
          },
          "action": {
            "enum": [
              "ACTIVATE",
              "FREEZE",
              "UNFREEZE",
              "BLOCK",
              "TERMINATE",
              "REPLACE",
              "DELIVER"
            ]
          },
          "cardId": {
            "type": "string"
          },
          "expectedVersion": {
            "type": "integer",
            "minimum": 1
          }
        },
        "required": [
          "expected_revision",
          "reason",
          "action",
          "cardId",
          "expectedVersion"
        ]
      },
      "DispatchCommand": {
        "type": "object",
        "properties": {
          "expected_revision": {
            "type": "integer",
            "minimum": 0,
            "format": "int64"
          },
          "reason": {
            "type": "string",
            "minLength": 10,
            "maxLength": 500
          },
          "action": {
            "const": "DISPATCH"
          },
          "cardId": {
            "type": "string"
          },
          "expectedVersion": {
            "type": "integer",
            "minimum": 1
          },
          "trackingReference": {
            "type": "string",
            "minLength": 6,
            "maxLength": 80
          }
        },
        "required": [
          "expected_revision",
          "reason",
          "action",
          "cardId",
          "expectedVersion",
          "trackingReference"
        ]
      },
      "ControlsCommand": {
        "type": "object",
        "properties": {
          "expected_revision": {
            "type": "integer",
            "minimum": 0,
            "format": "int64"
          },
          "reason": {
            "type": "string",
            "minLength": 10,
            "maxLength": 500
          },
          "action": {
            "const": "UPDATE_CONTROLS"
          },
          "cardId": {
            "type": "string"
          },
          "expectedVersion": {
            "type": "integer",
            "minimum": 1
          },
          "limits": {
            "$ref": "#/components/schemas/Limits"
          },
          "channels": {
            "$ref": "#/components/schemas/Channels"
          }
        },
        "required": [
          "expected_revision",
          "reason",
          "action",
          "cardId",
          "expectedVersion",
          "limits",
          "channels"
        ]
      },
      "ExportCommand": {
        "type": "object",
        "properties": {
          "expected_revision": {
            "type": "integer",
            "minimum": 0,
            "format": "int64"
          },
          "reason": {
            "type": "string",
            "minLength": 10,
            "maxLength": 500
          },
          "action": {
            "const": "EXPORT"
          },
          "cardIds": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "uniqueItems": true
          }
        },
        "required": [
          "expected_revision",
          "reason",
          "action",
          "cardIds"
        ]
      },
      "IssuingCommand": {
        "oneOf": [
          {
            "$ref": "#/components/schemas/IssueCommand"
          },
          {
            "$ref": "#/components/schemas/ActionCommand"
          },
          {
            "$ref": "#/components/schemas/DispatchCommand"
          },
          {
            "$ref": "#/components/schemas/ControlsCommand"
          },
          {
            "$ref": "#/components/schemas/ExportCommand"
          }
        ]
      }
    }
  }
}
