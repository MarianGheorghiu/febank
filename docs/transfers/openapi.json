{
  "openapi": "3.0.3",
  "info": {
    "title": "MBank Customer Transfers",
    "version": "1.0.0"
  },
  "security": [
    {
      "sessionCookie": []
    }
  ],
  "paths": {
    "/v1/me/transfers": {
      "get": {
        "operationId": "getTransfers",
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TransferSnapshot"
                }
              }
            }
          },
          "401": {
            "description": "Authentication required",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "Access denied",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "Resource not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "409": {
            "description": "State, quote or idempotency conflict",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "422": {
            "description": "Validation failed",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "429": {
            "description": "Rate limited",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "Route unavailable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      },
      "post": {
        "operationId": "submitTransfer",
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TransferSnapshot"
                }
              }
            }
          },
          "401": {
            "description": "Authentication required",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "Access denied",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "Resource not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "409": {
            "description": "State, quote or idempotency conflict",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "422": {
            "description": "Validation failed",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "429": {
            "description": "Rate limited",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "Route unavailable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SubmitTransfer"
              }
            }
          }
        },
        "parameters": [
          {
            "in": "header",
            "name": "Idempotency-Key",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 8,
              "maxLength": 100
            }
          }
        ]
      }
    },
    "/v1/me/transfers/quotes": {
      "post": {
        "operationId": "quoteTransfer",
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TransferQuote"
                }
              }
            }
          },
          "401": {
            "description": "Authentication required",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "Access denied",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "Resource not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "409": {
            "description": "State, quote or idempotency conflict",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "422": {
            "description": "Validation failed",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "429": {
            "description": "Rate limited",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "Route unavailable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/TransferDraft"
              }
            }
          }
        }
      }
    },
    "/v1/me/transfers/{id}/cancel": {
      "post": {
        "operationId": "cancelTransfer",
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TransferSnapshot"
                }
              }
            }
          },
          "401": {
            "description": "Authentication required",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "Access denied",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "Resource not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "409": {
            "description": "State, quote or idempotency conflict",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "422": {
            "description": "Validation failed",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "429": {
            "description": "Rate limited",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "Route unavailable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "parameters": [
          {
            "in": "header",
            "name": "Idempotency-Key",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 8,
              "maxLength": 100
            }
          },
          {
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ]
      }
    }
  },
  "components": {
    "securitySchemes": {
      "sessionCookie": {
        "type": "apiKey",
        "in": "cookie",
        "name": "session"
      }
    },
    "schemas": {
      "TransferKind": {
        "type": "string",
        "enum": [
          "fiat",
          "crypto",
          "stock"
        ]
      },
      "TransferState": {
        "type": "string",
        "enum": [
          "pending",
          "processing",
          "completed",
          "rejected",
          "cancelled"
        ]
      },
      "TransferAccount": {
        "type": "object",
        "required": [
          "id",
          "kind",
          "asset",
          "name",
          "decimals",
          "available",
          "reserved",
          "usd_price"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "kind": {
            "$ref": "#/components/schemas/TransferKind"
          },
          "asset": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "decimals": {
            "type": "integer"
          },
          "available": {
            "type": "string",
            "pattern": "^\\d+(\\.\\d+)?$"
          },
          "reserved": {
            "type": "string",
            "pattern": "^\\d+(\\.\\d+)?$"
          },
          "usd_price": {
            "type": "string",
            "pattern": "^\\d+(\\.\\d+)?$"
          }
        }
      },
      "TransferFeePolicy": {
        "type": "object",
        "required": [
          "fixed",
          "rate_bps",
          "minimum",
          "debit_account_id"
        ],
        "properties": {
          "fixed": {
            "type": "string"
          },
          "rate_bps": {
            "type": "integer",
            "minimum": 0,
            "maximum": 10000,
            "description": "Integer basis points; 10 means 0.10 percent."
          },
          "minimum": {
            "type": "string"
          },
          "maximum": {
            "type": "string"
          },
          "debit_account_id": {
            "type": "string"
          }
        },
        "description": "Server-supplied fee: fixed + percentage rounded up in fee-account minor units, clamped to minimum/maximum."
      },
      "TransferRoute": {
        "type": "object",
        "required": [
          "id",
          "asset",
          "name",
          "destination_kind",
          "fee",
          "eta",
          "enabled"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "asset": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "destination_kind": {
            "type": "string",
            "enum": [
              "iban",
              "phone",
              "wallet",
              "custody"
            ]
          },
          "network": {
            "type": "string"
          },
          "fee": {
            "type": "string",
            "pattern": "^\\d+(\\.\\d+)?$"
          },
          "fee_policy": {
            "$ref": "#/components/schemas/TransferFeePolicy"
          },
          "eta": {
            "type": "string"
          },
          "enabled": {
            "type": "boolean"
          }
        }
      },
      "TransferDraft": {
        "type": "object",
        "required": [
          "source_account_id",
          "route_id",
          "amount",
          "recipient_name",
          "destination",
          "reference"
        ],
        "properties": {
          "source_account_id": {
            "type": "string"
          },
          "route_id": {
            "type": "string"
          },
          "amount": {
            "type": "string",
            "pattern": "^\\d+(\\.\\d+)?$"
          },
          "recipient_name": {
            "type": "string"
          },
          "destination": {
            "type": "string"
          },
          "reference": {
            "type": "string"
          }
        }
      },
      "TransferQuote": {
        "type": "object",
        "required": [
          "id",
          "draft",
          "asset",
          "fee",
          "total",
          "value_usd",
          "expires_at",
          "eta"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "draft": {
            "$ref": "#/components/schemas/TransferDraft"
          },
          "asset": {
            "type": "string"
          },
          "fee": {
            "type": "string",
            "pattern": "^\\d+(\\.\\d+)?$"
          },
          "fee_asset": {
            "type": "string",
            "description": "Asset charged for the fee; defaults to transfer asset for legacy responses."
          },
          "fee_account_id": {
            "type": "string",
            "description": "Account reserving the fee. Stock custody fees use the USD account."
          },
          "total": {
            "type": "string",
            "pattern": "^\\d+(\\.\\d+)?$",
            "description": "Amount reserved from the source account. Add the fee separately when fee_account_id differs from the source account."
          },
          "value_usd": {
            "type": "string",
            "pattern": "^\\d+(\\.\\d+)?$"
          },
          "expires_at": {
            "type": "string",
            "format": "date-time"
          },
          "eta": {
            "type": "string"
          }
        }
      },
      "CustomerTransfer": {
        "type": "object",
        "required": [
          "id",
          "account_id",
          "kind",
          "asset",
          "amount",
          "fee",
          "value_usd",
          "direction",
          "recipient_name",
          "destination",
          "route_id",
          "reference",
          "status",
          "created_at",
          "updated_at",
          "can_cancel"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "account_id": {
            "type": "string"
          },
          "kind": {
            "$ref": "#/components/schemas/TransferKind"
          },
          "asset": {
            "type": "string"
          },
          "amount": {
            "type": "string",
            "pattern": "^\\d+(\\.\\d+)?$"
          },
          "fee": {
            "type": "string",
            "pattern": "^\\d+(\\.\\d+)?$"
          },
          "fee_asset": {
            "type": "string",
            "description": "Asset charged for the fee; defaults to transfer asset for legacy responses."
          },
          "fee_account_id": {
            "type": "string",
            "description": "Account reserving the fee. Stock custody fees use the USD account."
          },
          "value_usd": {
            "type": "string",
            "pattern": "^\\d+(\\.\\d+)?$"
          },
          "direction": {
            "type": "string",
            "enum": [
              "incoming",
              "outgoing"
            ]
          },
          "recipient_name": {
            "type": "string"
          },
          "destination": {
            "type": "string"
          },
          "route_id": {
            "type": "string"
          },
          "reference": {
            "type": "string"
          },
          "status": {
            "$ref": "#/components/schemas/TransferState"
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          },
          "updated_at": {
            "type": "string",
            "format": "date-time"
          },
          "can_cancel": {
            "type": "boolean"
          }
        }
      },
      "TransferSnapshot": {
        "type": "object",
        "required": [
          "schema_version",
          "mode",
          "as_of",
          "accounts",
          "routes",
          "transfers",
          "limits"
        ],
        "properties": {
          "schema_version": {
            "type": "integer",
            "enum": [
              1
            ]
          },
          "mode": {
            "type": "string",
            "enum": [
              "demo",
              "live"
            ]
          },
          "as_of": {
            "type": "string",
            "format": "date-time"
          },
          "accounts": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/TransferAccount"
            }
          },
          "routes": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/TransferRoute"
            }
          },
          "transfers": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/CustomerTransfer"
            }
          },
          "limits": {
            "$ref": "#/components/schemas/TransferLimits"
          }
        }
      },
      "TransferLimits": {
        "type": "object",
        "required": [
          "currency",
          "daily_limit",
          "used",
          "resets_at",
          "verification_label"
        ],
        "properties": {
          "currency": {
            "type": "string",
            "enum": [
              "USD"
            ]
          },
          "daily_limit": {
            "type": "string",
            "pattern": "^\\d+(\\.\\d+)?$"
          },
          "used": {
            "type": "string",
            "pattern": "^\\d+(\\.\\d+)?$"
          },
          "resets_at": {
            "type": "string",
            "format": "date-time"
          },
          "verification_label": {
            "type": "string"
          }
        }
      },
      "Error": {
        "type": "object",
        "required": [
          "error"
        ],
        "properties": {
          "error": {
            "type": "object",
            "required": [
              "code",
              "message"
            ],
            "properties": {
              "code": {
                "type": "string"
              },
              "message": {
                "type": "string"
              },
              "field": {
                "type": "string"
              }
            }
          }
        }
      },
      "SubmitTransfer": {
        "type": "object",
        "required": [
          "quote_id"
        ],
        "properties": {
          "quote_id": {
            "type": "string"
          }
        }
      }
    }
  }
}
